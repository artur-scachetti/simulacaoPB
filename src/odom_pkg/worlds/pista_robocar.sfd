<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="pista_robocar_world">

    <!-- Sol e Luz do Ambiente -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="pista_robocar">
      <static>true</static>

      <!-- Base do Asfalto (13.0m x 9.0m) -->
      <link name="chao_asfalto">
        <pose>0 0 -0.005 0 0 0</pose>
        <collision name="collision_chao">
          <geometry>
            <box>
              <size>13.0 9.0 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual_chao">
          <geometry>
            <box>
              <size>13.0 9.0 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>

